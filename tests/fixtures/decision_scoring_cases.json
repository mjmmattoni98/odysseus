        "criteria": [{"id": "q", "name": "Quality", "weight": 1}, {"id": "v", "name": "Value", "weight": 1}],
        "options": [
          {"id": "a", "name": "A", "scores": {"q": 9, "v": 9}, "fails": ["c1"]},
